# Copy to contracts/.env and fill in. contracts/.env is gitignored.
# Foundry loads it automatically when forge runs from contracts/, and the
# Makefile includes it for the guards and --sender.

# 1. RPC: Alchemy dashboard -> New app -> Base Sepolia -> HTTPS URL
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# 2. Deployer keystore address: cast wallet new ~/.foundry/keystores deployer
DEPLOYER_ADDRESS=0xYOUR_DEPLOYER_ADDRESS

# 3. Verification: one Etherscan V2 key covers Base Sepolia (Basescan is Etherscan)
BASESCAN_API_KEY=YOUR_ETHERSCAN_V2_KEY

# 4. Faucet economics, 6-decimal mUSDC units:
#    100 mUSDC per claim, 1 day cooldown, 500 mUSDC lifetime cap per address
FAUCET_AMOUNT=100000000
FAUCET_COOLDOWN=86400
FAUCET_CAP=500000000
